! ${name}: generated by make_scenario from scenarios/${name}/scenario.yaml

&equations
MaterialFileName = 'material.yaml'
Plasticity = 0
numflux = 'godunov'
numfluxnearfault = 'godunov'
/

&IniCondition
/

&DynamicRupture
FL = 16                         ! linear slip-weakening
${forced_rupture_t0}ModelFileName = 'fault.yaml'
refPointMethod = 1              ! (XRef,YRef,ZRef) is a direction, sets the normal sign only
XRef = 1.0
YRef = 0.0
ZRef = 0.0
OutputPointType = 4             ! 4: elementwise (ParaView) output only
SlipRateOutputType = 1
/

&Elementwise
printtimeinterval_sec = ${fault_interval}
OutputMask = ${fault_mask}   ! bit 12 is thermal pressurization only
refinement_strategy = 2
refinement = ${fault_refinement}
/

&Pickpoint
printtimeinterval = 1
OutputMask = 1 1 1 1
PPFileName = 'dummy_faultreceivers.dat'   ! not read with OutputPointType = 4
/

&SourceType
/

&SpongeLayer
/

&MeshNml
MeshFile = 'mesh.puml.hdf5'     ! pumgen -s msh2 mesh.msh mesh.puml.hdf5
meshgenerator = 'PUML'
/

&Discretization
CFL = ${cfl}
ClusteredLTS = ${lts}                ! 1: global time stepping, 2: rate-2 LTS
/

&Output
OutputFile = 'output/decatur'
WavefieldOutput = ${wavefield}
iOutputMask = ${wavefield_mask}
ReceiverOutput = ${receivers}              ! must be 0 when no RFileName is given
Checkpoint = 0
SurfaceOutput = ${surface}
SurfaceOutputRefinement = ${surface_refinement}
SurfaceOutputInterval = ${surface_interval}
xdmfWriterBackend = 'HDF5'
EnergyOutput = 1
EnergyTerminalOutput = 1
EnergyOutputInterval = ${energy_interval}
/

&AbortCriteria
EndTime = ${end_time}
/

&Analysis
/

&Debugging
/
